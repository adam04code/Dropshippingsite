{
  "name": "chronos-dropshipping",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CHRONOS - tienda de relojes dropshipping con Vue 3, Vuetify 3 y servidor Node",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "serve": "npm run build && npm start"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "concurrently": "^9.0.0",
    "vite": "^5.4.0",
    "vite-plugin-vuetify": "^2.0.4"
  }
}
